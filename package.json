{
  "name": "yazi-fm",
  "version": "0.1.1",
  "private": true,
  "description": "Yazi-faithful keyboard file manager for Obsidian",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "install-vault": "npm run build && node scripts/install.mjs",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "obsidian": "^1.14.4",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "smol-toml": "^1.9.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zulerne/obsidian-yazi"
  },
  "author": "zulerne"
}
